rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profile and subcollections
    match /users/{userId} {
      allow get, update, delete: if isOwner(userId);
      allow create: if isOwner(userId);

      // Financial years
      match /financialYears/{yearId} {
        allow read, write: if isOwner(userId);
      }

      // Stock trades (Buy and Sell)
      match /trades/{tradeId} {
        allow read, write: if isOwner(userId);
      }

      // Incomes
      match /incomes/{incomeId} {
        allow read, write: if isOwner(userId);
      }

      // Expenses
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }

      // Chart of Accounts
      match /accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }

      // Journal Entries
      match /journalEntries/{journalId} {
        allow read, write: if isOwner(userId);
      }

      // Synced Devices
      match /syncedDevices/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
